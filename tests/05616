. tests/variables
if [ "$HAVE_PCP" = "y" ] && [ "$HAVE_PMI_APPEND" = "y" ]; then
	# sadc direct PCP write then sar read-back (sadc -O pcp path).
	# The resulting archive is left behind for the read-only tests
	# 05620, 05622, 05623, 05624 and 05625; 05628 removes it.
	rm -f tests/pcpar-sadc tests/pcpar-sadc.*
	rm -f tests/root
	ln -s ${T_SRCDIR}/tests/root1 tests/root
	TZ=GMT ./sadc --unix_time=1555593619 -S XALL,-A_PWR_FAN,-A_PWR_IN,-A_PWR_TEMP,-A_PWR_FREQ \
		-O pcp tests/pcpar-sadc 1 1 >/dev/null 2>&1
	rm -f tests/root
	ln -s ${T_SRCDIR}/tests/root2 tests/root
	TZ=GMT ./sadc --unix_time=1555593629 -S XALL \
		-O pcp tests/pcpar-sadc 1 1 >/dev/null 2>&1
	# Read back with sar and verify we get CPU output
	LC_ALL=C TZ=GMT ./sar -u -f tests/pcpar-sadc > tests/out.sar-pcp-sadc.tmp 2>/dev/null
	grep -q "SYSSTAT.TEST\|%user\|%idle" tests/out.sar-pcp-sadc.tmp || exit 1
	# Also check that sadc.* provenance metrics are in the archive
	pminfo -a tests/pcpar-sadc pmimport.version pmimport.args > /dev/null 2>&1 || exit 1
	rm -f tests/root
	ln -s ${T_SRCDIR}/tests/root1 tests/root
else
	echo Skipped; touch tests/SKIPPED
fi
