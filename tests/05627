. tests/variables
if [ "$HAVE_PCP" = "y" ] && [ "$HAVE_PMI_APPEND" = "y" ]; then
	# Regression test: -O sa+pcp must continue writing native sa file correctly.
	# A broken dual-output mode would either crash sadc or produce an empty/corrupt
	# native file.
	rm -f tests/sa18 tests/sa18.*
	rm -f tests/root
	ln -s ${T_SRCDIR}/tests/root1 tests/root
	TZ=GMT ./sadc --unix_time=1555593619 \
		-S XALL,-A_PWR_FAN,-A_PWR_IN,-A_PWR_TEMP,-A_PWR_FREQ \
		-O sa+pcp tests/sa18 1 1 >/dev/null 2>&1 || exit 1
	# Native sa file must exist and be non-empty
	[ -s tests/sa18 ] || exit 1
	# PCP archive must also exist
	[ -f tests/sa18.0 ] || exit 1
	# Remove the PCP archive: with <base>.meta present sar would read that
	# instead of the native file.
	rm -f tests/sa18.0 tests/sa18.meta tests/sa18.index
	# Native file must be readable by sar
	LC_ALL=C TZ=GMT ./sar -u -f tests/sa18 > /dev/null 2>&1 || exit 1
	rm -f tests/sa18 tests/sa18.*
	rm -f tests/root
	ln -s ${T_SRCDIR}/tests/root1 tests/root
else
	echo Skipped; touch tests/SKIPPED
fi
